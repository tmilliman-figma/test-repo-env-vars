{
  "name": "test-repo-env-vars",
  "version": "0.1.0",
  "private": true,
  "description": "A small React + Vite and Node.js app for demonstrating environment variables safely.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:backend": "node --env-file-if-exists=.env backend/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.5"
  }
}
